# OPTIONAL. Only the AI path (evaluate_labels --ai, check_ai_setup --smoke) uses
# this file. Everything else in Feedlytics runs without it, and so do the tests.
# To enable the AI path: copy this file to .env and fill in your own values.
# Never commit .env.
ANTHROPIC_API_KEY=your-api-key-here

# Optional: override the model (default: claude-opus-5-5).
# FEEDLYTICS_MODEL=claude-opus-5-5
